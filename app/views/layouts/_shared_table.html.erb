<% collection ||= [] %>
<% columns ||= [] %>
<% empty_message ||= "Nenhum registro encontrado." %>

<% if collection.any? %>
  <div class="card shadow-sm border-0 rounded-3">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light text-secondary">
          <tr>
            <% columns.each do |col| %>
              <th class="fw-semibold border-bottom"><%= col[:header] %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% collection.each do |item| %>
            <tr>
              <% columns.each do |col| %>
                <td class="border-bottom-0 border-top text-dark">
                  <% if col[:custom_render] %>
                    <%= col[:custom_render].call(item) %>
                  <% elsif col[:attribute] %>
                    <%= item.send(col[:attribute]) rescue nil %>
                  <% else %>
                    N/A
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @pagy.present? %>
    <div class="mt-3">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %>
<% else %>
  <div class="alert alert-light text-center border-dashed py-5 text-muted" role="alert">
    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
    <%= empty_message %>
  </div>
<% end %>