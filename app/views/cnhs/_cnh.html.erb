<% registro = local_assigns[:cnh] || @cnh %>
<% voltar_path = current_funcionario.gerente? ? lista_motoristas_path : motorista_dashboard_path %>

<div class="card shadow-sm mb-4 border-0">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
    <div>
      <h4 class="mb-1">Detalhes da CNH</h4>
      <small class="text-white-50">Registro <%= registro.numero_registro %></small>
    </div>

    <%= botoes_aplicacao(edit_cnh_path(registro), "Editar") %>
  </div>

  <div class="card-body p-4">
    <div class="row g-4 mb-4">
      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100 bg-light-subtle">
          <p class="text-uppercase text-muted small fw-semibold mb-2">Categoria</p>
          <p class="mb-0 fw-semibold"><i class="bi bi-person-vcard-fill me-2"></i><%= registro.cat_cnh %></p>
        </div>
      </div>

      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100 bg-light-subtle">
          <p class="text-uppercase text-muted small fw-semibold mb-2">Status</p>
          <span class="badge <%= cnh_status_cor_classe(registro.status) %> fw-bold"><%= registro.status %></span>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-card-text me-2"></i>Número de registro</strong>
          <span class="text-muted"><%= registro.numero_registro %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-calendar2-check me-2"></i>Primeira CNH</strong>
          <span class="text-muted"><%= registro.primeira_cnh.present? ? l(registro.primeira_cnh) : "Não informada" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-calendar-event me-2"></i>Data de expedição</strong>
          <span class="text-muted"><%= registro.data_expedicao.present? ? l(registro.data_expedicao) : "Não informada" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-calendar-x me-2"></i>Validade</strong>
          <span class="text-muted"><%= registro.validade.present? ? l(registro.validade) : "Não informada" %></span>
        </div>
      </div>
    </div>

    <div class="border rounded-3 p-3 bg-light-subtle">
      <strong class="d-block mb-1"><i class="bi bi-chat-left-text me-2"></i>Observações</strong>
      <span class="text-muted"><%= registro.observacoes.presence || "Nenhuma observação cadastrada" %></span>
    </div>
  </div>

  <div class="card-footer bg-light d-flex justify-content-end">
    <%= botoes_aplicacao(voltar_path, "Voltar") %>
  </div>
</div>
