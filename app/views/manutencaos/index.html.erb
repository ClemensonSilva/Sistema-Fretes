<%# app/views/manutencoes/_tabela_manutencoes.html.erb %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="h3 mb-0 text-gray-800">Registros de Manutenções</h2>
  <%= botoes_aplicacao(new_manutencao_path, "Nova Manutenção") %>
</div>

<%= render 'layouts/shared_table',
  collection: @manutencoes,
  columns: [
    { 
      header: "Veículo", 
      custom_render: Proc.new { |manutencao| 
        placa = placa_modelo(manutencao.veiculo)
        placa.present? ? "<span class='fw-medium'>#{placa}</span>".html_safe : "N/A"
      } 
    },
    { 
      header: "Tipo", 
      # Assumindo que seu helper tipo_manutencao_cor_classe já gera uma badge/pílula colorida
      custom_render: Proc.new { |manutencao| tipo_manutencao_cor_classe(manutencao.tipo) } 
    },
    { 
      header: "Data Agendada", 
      custom_render: Proc.new { |manutencao| l(manutencao.data_agendada) } 
    },
    { 
      header: "Custo", 
      custom_render: Proc.new { |manutencao| 
        number_to_currency(manutencao.custo, unit: "R$ ", separator: ",", delimiter: ".") 
      } 
    },
    { 
      header: "Ações", 
      custom_render: Proc.new { |manutencao|
        # Removemos os botões da coluna de custo e criamos a coluna dedicada de Ações usando o gap-2
        "<div class='d-flex gap-2'>".html_safe +
          botoes_aplicacao(manutencao_detalhes_path(manutencao), "Detalhar") +
          botoes_aplicacao(edit_manutencao_path(manutencao), "Editar") +
          botoes_aplicacao(manutencao_path(manutencao), "Excluir", :delete) +
        "</div>".html_safe
      }
    }
  ],
  empty_heading: "Nenhuma manutenção encontrada.",
  empty_message: Proc.new { "Nenhuma manutenção registrada." }
%>