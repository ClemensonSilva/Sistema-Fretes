<% registro = local_assigns[:manutencao] || @manutencao %>

<div class="card shadow-sm mb-4 border-0">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
    <div>
      <h4 class="mb-1">Detalhes da Manutenção</h4>
      <small class="text-white-50">Registro #<%= registro.id %></small>
    </div>

    <%= botoes_aplicacao(edit_manutencao_path(registro), "Editar", { turbo_frame: "modal" }) %>
  </div>

  <div class="card-body p-4">
    <div class="row g-4 mb-4">
      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100 bg-light-subtle">
          <p class="text-uppercase text-muted small fw-semibold mb-2">Veículo</p>
          <% if registro.veiculo.present? %>
            <p class="mb-0 fw-semibold"><i class="bi bi-car-front-fill me-2"></i><%= registro.veiculo.placa %> - <%= registro.veiculo.modelo %></p>
          <% else %>
            <p class="mb-0 text-warning"><i class="bi bi-exclamation-circle me-2"></i>Não atribuído</p>
          <% end %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100 bg-light-subtle">
          <p class="text-uppercase text-muted small fw-semibold mb-2">Tipo</p>
          <p class="mb-0 fw-semibold"><i class="bi bi-tools me-2"></i><%= registro.tipo.presence || "Não informado" %></p>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-shop me-2"></i>Oficina</strong>
          <span class="text-muted"><%= registro.oficina.presence || "Não informada" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-calendar-check-fill me-2"></i>Data agendada</strong>
          <span class="text-muted"><%= registro.data_agendada.present? ? l(registro.data_agendada) : "Aguardando agendamento" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-calendar-check me-2"></i>Data de entrega</strong>
          <span class="text-muted"><%= registro.data_entrega_veiculo.present? ? l(registro.data_entrega_veiculo) : "Ainda não entregue" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-card-text me-2"></i>Descrição</strong>
          <span class="text-muted"><%= registro.descricao.presence || "Nenhuma descrição fornecida" %></span>
        </div>
      </div>
    </div>

    <div class="border rounded-3 p-3 bg-success-subtle d-flex justify-content-between align-items-center mb-3">
      <span class="fw-semibold text-success-emphasis"><i class="bi bi-cash-coin me-2"></i>Custo estimado</span>
      <span class="text-success fw-bold fs-4">
        <% if registro.custo.present? %>
          <%= number_to_currency(registro.custo, unit: "R$", separator: ",", delimiter: ".") %>
        <% else %>
          Custo pendente
        <% end %>
      </span>
    </div>

    <div class="row g-3 text-muted small">
      <div class="col-md-6">
        <strong class="d-block mb-1"><i class="bi bi-clock-fill me-2"></i>Criado em</strong>
        <span><%= l(registro.created_at, format: :short) %></span>
      </div>
      <div class="col-md-6">
        <strong class="d-block mb-1"><i class="bi bi-arrow-clockwise me-2"></i>Última atualização</strong>
        <span><%= l(registro.updated_at, format: :short) %></span>
      </div>
    </div>
  </div>

  <div class="card-footer bg-light d-flex justify-content-end">
    <%= botoes_aplicacao(lista_manutencoes_path, "Voltar") %>
  </div>
</div>
