<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="h3 mb-0 text-gray-800">Registros de Veículos</h2>
  <%= botoes_aplicacao(new_veiculo_path, "Cadastrar Veículo") %>
</div>

<%= render 'layouts/shared_table',
  collection: @veiculos,
  columns: [
    {
      header: "Placa - Modelo",
      custom_render: Proc.new { |veiculo| "<span class='fw-medium'>#{placa_modelo(veiculo)}</span>".html_safe }
    },
    {
      header: "Categoria",
      custom_render: Proc.new { |veiculo| 
        "<span class='badge bg-secondary text-white px-2 py-1 rounded-pill'>#{veiculo.categoria_veiculo}</span>".html_safe 
      }
    },
    {
      header: "Quilometragem",
      custom_render: Proc.new { |veiculo| "#{number_with_precision(veiculo.quilometragem_km, precision: 2, separator: ',', delimiter: '.')} km" }
    },
    {
      header: "Ano",
      custom_render: Proc.new { |veiculo| veiculo.ano_fabricacao&.year || "N/A" }
    },
    { 
      header: "Ações",
      custom_render: Proc.new { |veiculo|
        "<div class='d-flex gap-2'>".html_safe +
          botoes_aplicacao(veiculo_path(veiculo), "Detalhar", {turbo_frame: "modal"}) +
          botoes_aplicacao(edit_veiculo_path(veiculo), "Editar", {turbo_frame: "modal"}) +
          botoes_aplicacao(veiculo_path(veiculo), 'Excluir', :delete) +
        "</div>".html_safe
      }
    }
  ],
  empty_heading: "Nenhum veículo encontrado.",
  empty_message: Proc.new { "Parece que não há veículos registrados em sua frota ainda." }
%>