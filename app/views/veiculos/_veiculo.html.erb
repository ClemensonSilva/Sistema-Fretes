<% registro = local_assigns[:veiculo] || @veiculo %>

<div class="card shadow-sm mb-4 border-0">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
    <div>
      <h4 class="mb-1">Detalhes do Veículo</h4>
      <small class="text-white-50"><%= registro.placa %></small>
    </div>

    <%= botoes_aplicacao(edit_veiculo_path(registro), "Editar", { turbo_frame: "modal" }) %>
  </div>

  <div class="card-body p-4">
    <div class="row g-4 mb-4">
      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100 bg-light-subtle">
          <p class="text-uppercase text-muted small fw-semibold mb-2">Modelo</p>
          <p class="mb-0 fw-semibold"><i class="bi bi-car-front-fill me-2"></i><%= registro.marca %> - <%= registro.modelo %></p>
        </div>
      </div>

      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100 bg-light-subtle">
          <p class="text-uppercase text-muted small fw-semibold mb-2">Ano de fabricação</p>
          <p class="mb-0 fw-semibold"><i class="bi bi-calendar2-event me-2"></i><%= registro.ano_fabricacao&.year || "Não informado" %></p>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-fuel-pump-fill me-2"></i>Tipo de combustível</strong>
          <span class="text-muted"><%= registro.tipo_combustivel.presence || "Não informado" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-tags-fill me-2"></i>Categoria</strong>
          <span class="text-muted"><%= registro.categoria_veiculo.presence || "Não informada" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-speedometer2 me-2"></i>Velocidade máx. controlada</strong>
          <span class="text-muted">
            <% if registro.vel_max_controlada.present? %>
              <%= number_with_precision(registro.vel_max_controlada, precision: 2, separator: ",", delimiter: ".") %> km/h
            <% else %>
              Não definida
            <% end %>
          </span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-thermometer-high me-2"></i>Status</strong>
          <span class="<%= veiculo_status_cor_classe(registro.status) %> fw-bold"><%= registro.status %></span>
        </div>
      </div>
    </div>

    <div class="border rounded-3 p-3 bg-success-subtle d-flex justify-content-between align-items-center">
      <span class="fw-semibold text-success-emphasis"><i class="bi bi-road me-2"></i>Quilometragem</span>
      <span class="text-success fw-bold fs-4">
        <% if registro.quilometragem_km.present? %>
          <%= number_with_precision(registro.quilometragem_km, precision: 2, separator: ",", delimiter: ".") %> km
        <% else %>
          Não informada
        <% end %>
      </span>
    </div>
  </div>

  <div class="card-footer bg-light d-flex justify-content-end">
    <%= botoes_aplicacao(lista_veiculos_path, "Voltar") %>
  </div>
</div>
