<% registro = local_assigns[:abastecimento] || @abastecimento %>

<div class="card shadow-sm mb-4 border-0">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
    <div>
      <h4 class="mb-1">Detalhes do Abastecimento</h4>
      <small class="text-white-50">Registro #<%= registro.id %></small>
    </div>

    <%= botoes_aplicacao(edit_abastecimento_path(registro), "Editar", { turbo_frame: "modal" }) %>
  </div>

  <div class="card-body p-4">
    <div class="row g-4 mb-4">
      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100 bg-light-subtle">
          <p class="text-uppercase text-muted small fw-semibold mb-2">Veículo</p>
          <% if registro.veiculo.present? %>
            <p class="mb-0 fw-semibold"><i class="bi bi-car-front-fill me-2"></i><%= registro.veiculo.placa %> - <%= registro.veiculo.modelo %></p>
          <% else %>
            <p class="mb-0 text-warning"><i class="bi bi-exclamation-circle me-2"></i>Não informado</p>
          <% end %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100 bg-light-subtle">
          <p class="text-uppercase text-muted small fw-semibold mb-2">Posto</p>
          <p class="mb-0 fw-semibold"><i class="bi bi-geo-alt-fill me-2"></i><%= registro.nome_posto.presence || "Não informado" %></p>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-fuel-fill me-2"></i>Tipo de combustível</strong>
          <span class="text-muted">
            <% if registro.tipo_combustivel.present? %>
              <%= Abastecimento.human_attribute_name("tipo_combustivel_#{registro.tipo_combustivel}") %>
            <% else %>
              <em class="text-warning">Não informado</em>
            <% end %>
          </span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-calendar-check-fill me-2"></i>Data do abastecimento</strong>
          <span class="text-muted"><%= registro.data_abastecimento.present? ? l(registro.data_abastecimento) : "Não informada" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-speedometer2 me-2"></i>Quantidade</strong>
          <span class="text-muted"><%= number_with_precision(registro.quantidade_litros, precision: 2, separator: ",", delimiter: ".") %> L</span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-currency-dollar me-2"></i>Preço por litro</strong>
          <span class="text-muted"><%= number_to_currency(registro.preco_litro, unit: "R$", separator: ",", delimiter: ".") %></span>
        </div>
      </div>
    </div>

    <div class="border rounded-3 p-3 bg-success-subtle d-flex justify-content-between align-items-center">
      <span class="fw-semibold text-success-emphasis"><i class="bi bi-cash-coin me-2"></i>Total do abastecimento</span>
      <span class="text-success fw-bold fs-4"><%= number_to_currency(registro.quantidade_litros * registro.preco_litro, unit: "R$", separator: ",", delimiter: ".") %></span>
    </div>
  </div>

  <div class="card-footer bg-light d-flex justify-content-end">
    <%= botoes_aplicacao(lista_abastecimentos_path, "Voltar") %>
  </div>
</div>
