
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="h3 mb-0 text-gray-800">Registros de Abastecimentos</h2>
  
  <% if current_funcionario.motorista? %>
  <%= botoes_aplicacao(new_abastecimento_path, "Registrar Abastecimento", { turbo_frame: "modal" }) %>
  <% end %>
</div>

<%= render 'layouts/shared_table',
  collection: @abastecimentos,
  columns: [
    { 
      header: "Veículo", 
      custom_render: Proc.new { |abastecimento| 
        placa = placa_modelo(abastecimento.veiculo)
        placa.present? ? "<span class='fw-medium'>#{placa}</span>".html_safe : "N/A"
      } 
    },
    { 
      header: "Preço por Litro", 
      custom_render: Proc.new { |abastecimento| 
        number_to_currency(abastecimento.preco_litro, unit: "R$ ", separator: ",", delimiter: ".") 
      } 
    },
    { 
      header: "Quantidade", 
      custom_render: Proc.new { |abastecimento| 
        "#{number_with_precision(abastecimento.quantidade_litros, precision: 2, separator: ',', delimiter: '.')} L" 
      }
    },
    { 
      header: "Data", 
      custom_render: Proc.new { |abastecimento| 
        l(abastecimento.data_abastecimento) 
      } 
    },
    { 
      header: "Ações", 
      custom_render: Proc.new { |abastecimento|
        "<div class='d-flex gap-2'>".html_safe +
          botoes_aplicacao(abastecimento_detalhes_path(abastecimento), "Detalhar", { turbo_frame: "modal" }) +
          botoes_aplicacao(edit_abastecimento_path(abastecimento), "Editar", { turbo_frame: "modal" }) +
          botoes_aplicacao(abastecimento_path(abastecimento), "Excluir", :delete) +
        "</div>".html_safe
      }
    }
  ],
  empty_heading: "Nenhum abastecimento encontrado.",
  empty_message:  "Nenhum registro de abastecimento no sistema." 
%>