<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="h3 mb-0 text-gray-800">Visão Geral da Operação</h2>
  <span class="text-muted"><i class="bi bi-calendar3 me-1"></i> <%= Time.current.strftime("%d de %B de %Y") %></span>
</div>

<div class="row g-4 mb-5">
  
  <%# Card 1: Faturamento (Verde) %>
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card shadow-sm border-0 rounded-3 h-100">
      <div class="card-body d-flex align-items-center p-4">
        <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
          <i class="bi bi-cash-stack fs-3"></i>
        </div>
        <div>
          <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Faturamento Total</h6>
          <h4 class="mb-0 fw-bold text-dark"><%= number_to_currency(@faturamento_total, unit: "R$ ", separator: ",", delimiter: ".") %></h4>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card shadow-sm border-0 rounded-3 h-100">
      <div class="card-body d-flex align-items-center p-4">
        <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 me-3">
          <i class="bi bi-graph-down-arrow fs-3"></i>
        </div>
        <div>
          <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Custo Operacional</h6>
          <h4 class="mb-0 fw-bold text-dark"><%= number_to_currency(@custo_operacional, unit: "R$ ", separator: ",", delimiter: ".") %></h4>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card shadow-sm border-0 rounded-3 h-100">
      <div class="card-body d-flex align-items-center p-4">
        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
          <i class="bi bi-box-seam fs-3"></i>
        </div>
        <div>
          <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Fretes em Trânsito</h6>
          <h4 class="mb-0 fw-bold text-dark"><%= @fretes_em_andamento %></h4>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card shadow-sm border-0 rounded-3 h-100">
      <div class="card-body d-flex align-items-center p-4">
        <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
          <i class="bi bi-truck fs-3"></i>
        </div>
        <div>
          <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Frota Total</h6>
          <h4 class="mb-0 fw-bold text-dark"><%= @veiculos_total %> <small class="text-muted fs-6 fw-normal">veículos</small></h4>
        </div>
      </div>
    </div>
  </div>

</div>