<% registro = local_assigns[:frete] || @frete %>

<div class="card shadow-sm mb-4 border-0">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
    <div>
      <h4 class="mb-1">Detalhes do Frete</h4>
      <small class="text-white-50">Registro #<%= registro.id %></small>
    </div>

    <%= botoes_aplicacao(edit_frete_path(registro), "Editar", { turbo_frame: "modal" }) %>
  </div>

  <div class="card-body p-4">
    <div class="row g-4 mb-4">
      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100 bg-light-subtle">
          <p class="text-uppercase text-muted small fw-semibold mb-2">Origem</p>
          <p class="mb-0 fw-semibold"><i class="bi bi-geo-alt-fill me-2"></i><%= registro.origem.presence || "Não informada" %></p>
        </div>
      </div>

      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100 bg-light-subtle">
          <p class="text-uppercase text-muted small fw-semibold mb-2">Destino</p>
          <p class="mb-0 fw-semibold"><i class="bi bi-pin-map-fill me-2"></i><%= registro.destino.presence || "Não informado" %></p>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-truck me-2"></i>Veículo</strong>
          <span class="text-muted"><%= registro.veiculo.present? ? placa_modelo(registro.veiculo) : "Não atribuído" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-person-fill me-2"></i>Motorista</strong>
          <span class="text-muted"><%= registro.funcionario.present? ? dados_motorista(registro.funcionario) : "Não atribuído" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-calendar-check-fill me-2"></i>Data de saída</strong>
          <span class="text-muted"><%= registro.data_saida.present? ? l(registro.data_saida) : "Não informada" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-calendar-range-fill me-2"></i>Chegada prevista</strong>
          <span class="text-muted"><%= registro.data_chegada.present? ? l(registro.data_chegada) : "Não prevista" %></span>
        </div>
      </div>

      <div class="col-md-6">
        <div class="pb-2">
          <strong class="d-block mb-1"><i class="bi bi-info-circle-fill me-2"></i>Status</strong>
          <span class="<%= frete_status_cor_classe(registro.status) %> fw-bold"><%= frete_status_texto(registro.status) %></span>
        </div>
      </div>
    </div>

    <div class="border rounded-3 p-3 bg-success-subtle d-flex justify-content-between align-items-center">
      <span class="fw-semibold text-success-emphasis"><i class="bi bi-cash-coin me-2"></i>Preço do frete</span>
      <span class="text-success fw-bold fs-4">
        <% if registro.preco.present? %>
          <%= number_to_currency(registro.preco, unit: "R$", separator: ",", delimiter: ".") %>
        <% else %>
          Preço pendente
        <% end %>
      </span>
    </div>
  </div>

  <div class="card-footer bg-light d-flex justify-content-end">
    <%= botoes_aplicacao(lista_fretes_path, "Voltar") %>
  </div>
</div>
