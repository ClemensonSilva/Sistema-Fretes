

<%= form_with(model: frete, local: true) do |f| %>
  <% if frete.errors.any? %>
    <div id="error_explanation" class="alert alert-danger">
      <h2><%= pluralize(frete.errors.count, "erro") %> impediram que este frete fosse salvo:</h2>
      <ul>
        <% frete.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :veiculo_id, "Veículo", class: "form-label" %>
   
    <%= f.collection_select :veiculo_id, @veiculos_disponiveis, :id, ->(veiculo) { veiculo_opcao_label(veiculo) },
     { prompt: "Selecione o Veículo" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :funcionario_id, "Motorista", class: "form-label" %>
    
    <%= f.collection_select :funcionario_id, @motoristas, :id, :nome, { prompt: "Selecione o Motorista" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :preco, "Preço do Frete", class: "form-label" %>
    <%= f.number_field :preco, step: :any, class: "form-control", placeholder: "Ex: 1500.00" %>
  </div>

  <div class="mb-3">
    <%= f.label :status, "Status do Frete", class: "form-label" %>
    
    <%= f.select :status, Frete.statuses.keys.map { |s| [s.humanize, s] }, { prompt: "Selecione o Status" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :origem_cep, "CEP de origem", class: "form-label" %>
    <%= f.text_field :origem_cep, class: "form-control", placeholder: "Ex: 01001-000", inputmode: "numeric", maxlength: 9 %>
  </div>

  <div class="mb-3">
    <%= f.label :destino_cep, "CEP de destino", class: "form-label" %>
    <%= f.text_field :destino_cep, class: "form-control", placeholder: "Ex: 20040-020", inputmode: "numeric", maxlength: 9 %>
  </div>

  <div class="mb-3">
    <%= f.label :data_inicio, "Data de Saída", class: "form-label" %>
    <%= f.date_field :data_inicio, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :data_fim, "Data de Chegada", class: "form-label" %>
    <%= f.date_field :data_fim, class: "form-control" %>
  </div>

  <div class="d-flex justify-content-between align-items-center mt-4">
    <%= f.submit "Salvar Frete", class: "btn btn-primary" %>
    <%= botoes_aplicacao(fretes_path, "Cancelar") %>
  </div>
<% end %>
