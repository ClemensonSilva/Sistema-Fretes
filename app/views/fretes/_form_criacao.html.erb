<%
# Isso aqui será refatorado para um helper.
ufs = [
    ['Acre', 'AC'], ['Alagoas', 'AL'], ['Amapá', 'AP'], ['Amazonas', 'AM'], ['Bahia', 'BA'], 
    ['Ceará', 'CE'], ['Distrito Federal', 'DF'], ['Espírito Santo', 'ES'], ['Goiás', 'GO'], 
    ['Maranhão', 'MA'], ['Mato Grosso', 'MT'], ['Mato Grosso do Sul', 'MS'], ['Minas Gerais', 'MG'], 
    ['Pará', 'PA'], ['Paraíba', 'PB'], ['Paraná', 'PR'], ['Pernambuco', 'PE'], ['Piauí', 'PI'], 
    ['Rio de Janeiro', 'RJ'], ['Rio Grande do Norte', 'RN'], ['Rio Grande do Sul', 'RS'], 
    ['Rondônia', 'RO'], ['Roraima', 'RR'], ['Santa Catarina', 'SC'], ['São Paulo', 'SP'], 
    ['Sergipe', 'SE'], ['Tocantins', 'TO']
  ]
%>

<div data-controller="stepper calculadora-frete" class="modal-body">
  
  <%= form_with(model: frete, data: { turbo_frame: "_top" }) do |f| %>
    <% if frete.errors.any? %>
      <div id="error_explanation" class="alert alert-danger">
        <h6 class="mb-2"><%= pluralize(frete.errors.count, "erro") %> impediram o cadastro do frete:</h6>
        <ul class="mb-0">
          <% frete.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    <div data-stepper-target="step">
      <h5 class="mb-4 text-primary">Passo 1: Rota e Previsão</h5>
      <div class="mb-3 text-muted" data-calculadora-frete-target="feedback"></div>
      
      <h6 class="text-secondary mt-3">Local de Origem</h6>
  <div class="row mb-3" data-controller="estado-cidade">
    <div class="col-md-4">
      <%= f.label :origem_uf, "Estado (UF)", class: "form-label" %>
      <%= f.select :origem_uf, options_for_select(ufs), { prompt: "Selecione a UF" }, { class: "form-select", data: { estado_cidade_target: "uf", calculadora_frete_target: "origemUf", action: "change->estado-cidade#carregarCidades" } } %>
    </div>
    <div class="col-md-8">
      <%= f.label :origem_cidade, "Cidade", class: "form-label" %>
      <%= f.select :origem_cidade, [], { prompt: "Selecione um Estado primeiro" }, { class: "form-select", disabled: true, data: { estado_cidade_target: "cidade", calculadora_frete_target: "origemCidade", action: "change->calculadora-frete#calcular" } } %>
    </div>
  </div>
  
  <hr>

  <h6 class="text-secondary mt-3">Local de Destino</h6>
  <div class="row mb-3" data-controller="estado-cidade">
    <div class="col-md-4">
      <%= f.label :destino_uf, "Estado (UF)", class: "form-label" %>
      <%= f.select :destino_uf, options_for_select(ufs), { prompt: "Selecione a UF" }, { class: "form-select", data: { estado_cidade_target: "uf", calculadora_frete_target: "destinoUf", action: "change->estado-cidade#carregarCidades" } } %>
    </div>
    <div class="col-md-8">
      <%= f.label :destino_cidade, "Cidade", class: "form-label" %>
      <%= f.select :destino_cidade, [],
  { prompt: "Selecione um Estado primeiro" },
  {
    class: "form-select",
    disabled: true,
    data: {
      estado_cidade_target: "cidade",
      calculadora_frete_target: "destinoCidade",
      action: "change->calculadora-frete#calcular"
    }
  } %>
      </div>
  </div>

  <div class="d-flex justify-content-end mt-4">
    <button type="button" class="btn btn-primary" data-action="click->stepper#next">Próximo <i class="bi bi-arrow-right"></i></button>
  </div>
    </div>

    <div data-stepper-target="step" class="d-none">
      <h5 class="mb-4 text-primary">Passo 2: Veículo e Motorista</h5>
      
      <div class="mb-3">
        <%= f.label :veiculo_id, "Veículo", class: "form-label" %>
        <%= f.collection_select :veiculo_id, @veiculos_disponiveis, :id, ->(veiculo) { veiculo_opcao_label(veiculo) }, { prompt: "Selecione o Veículo" }, class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= f.label :funcionario_id, "Motorista", class: "form-label" %>
        <%= f.collection_select :funcionario_id, @motoristas, :id, :nome, { prompt: "Selecione o Motorista" }, class: "form-select" %>
      </div>

      <div class="d-flex justify-content-between mt-4">
        <button type="button" class="btn btn-secondary" data-action="click->stepper#previous"><i class="bi bi-arrow-left"></i> Anterior</button>
        <button type="button" class="btn btn-primary" data-action="click->stepper#next">Próximo <i class="bi bi-arrow-right"></i></button>
      </div>
    </div>

    <div data-stepper-target="step" class="d-none">
      <h5 class="mb-4 text-primary">Passo 3: Fechamento</h5>
      
      <div class="mb-3">
        <%= f.label :preco, "Preço do Frete", class: "form-label" %>
        <%= f.number_field :preco, step: 0.01, class: "form-control", placeholder: "Ex: 1500.00", data: { calculadora_frete_target: "precoInput" } %>
      </div>


      <div class="d-flex justify-content-between mt-4">
        <button type="button" class="btn btn-secondary" data-action="click->stepper#previous"><i class="bi bi-arrow-left"></i> Anterior</button>
        <%= f.submit "Cadastrar Frete", class: "btn btn-success" %>
      </div>
    </div>

  <% end %>
</div>