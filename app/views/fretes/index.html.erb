
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="h3 mb-0 text-gray-800">Registros de Fretes</h2>
  <%= botoes_aplicacao(new_frete_path, "Cadastrar Frete", {turbo_frame: "modal"}) %>
</div>

<%= render 'layouts/shared_table',
  collection: @fretes,
  columns: [
    { 
      header: "Veículo", 
      custom_render: Proc.new { |frete| "<span class='fw-medium'>#{placa_modelo(frete.veiculo)}</span>".html_safe } 
    },
    { 
      header: "Motorista", 
      custom_render: Proc.new { |frete| dados_motorista(frete.funcionario) } 
    },
    { 
      header: "Preço", 
      custom_render: Proc.new { |frete| number_to_currency(frete.preco, unit: "R$ ", separator: ",", delimiter: ".") } 
    },
    { 
      header: "Status", 
      custom_render: Proc.new { |frete| 
        "<span class='badge bg-secondary text-white px-2 py-1 rounded-pill'>#{frete_status_texto(frete.status)}</span>".html_safe 
      } 
    },
    { 
      header: "Ações", 
      custom_render: Proc.new { |frete|
        "<div class='d-flex gap-2'>".html_safe +
          botoes_aplicacao(frete_path(frete), "Detalhar", {turbo_frame: "modal"}) +
          botoes_aplicacao(edit_frete_path(frete), "Editar", {turbo_frame: "modal"}) +
          botoes_aplicacao(frete_path(frete), "Excluir", :delete) +
        "</div>".html_safe
      }
    }
  ],
  empty_heading: "Nenhum frete encontrado.",
  empty_message:  "Nenhum frete sob sua supervisão." 
%>