<% content_for :title, "Cadastro | Sistema Fretes" %>

<section class="container py-5 auth-page-bg">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
      <article class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
          <header class="mb-4 text-center">
            <span class="badge text-bg-success-subtle text-success-emphasis rounded-pill px-3 py-2 mb-3">Novo acesso</span>
            <h1 class="h3 mb-2">Criar conta</h1>
            <p class="text-body-secondary mb-0">Cadastre-se para usar o Sistema de Fretes.</p>
          </header>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "needs-validation", novalidate: true }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :email, "E-mail", class: "form-label fw-semibold" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg", placeholder: "voce@empresa.com", required: true, spellcheck: false, autocapitalize: "none" %>
            </div>

            <div class="mb-3">
              <%= f.label :password, "Senha", class: "form-label fw-semibold" %>
              <% if @minimum_password_length %>
                <small class="text-body-secondary d-block mb-1">Minimo de <%= @minimum_password_length %> caracteres</small>
              <% end %>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control form-control-lg", placeholder: "Crie uma senha", required: true %>
            </div>

            <div class="mb-4">
              <%= f.label :password_confirmation, "Confirmar senha", class: "form-label fw-semibold" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control form-control-lg", placeholder: "Repita a senha", required: true %>
            </div>

            <div class="d-grid mb-3">
              <%= f.submit "Criar conta", class: "btn btn-success btn-lg" %>
            </div>
          <% end %>

          <%= render "devise/shared/links" %>
        </div>
      </article>
    </div>
  </div>
</section>
